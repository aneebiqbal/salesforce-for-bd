# Supabase (use .env or .env.local - restart dev server after changes)
# Dashboard: Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the "anon" "public" key only (never use service_role in the browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Only for scripts/create-users.mjs (create users without email verification). Do NOT use in frontend.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
